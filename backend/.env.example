# .env.example

# ---------------------------------------------------------
# Security Settings (Mandatory)
# ---------------------------------------------------------

# Generate a strong 32+ character JWT secret key:
# You can use: `openssl rand -hex 32`
JWT_SECRET_KEY="8db2567d0af6622057f4bc5fc4f551faf3753d3889a7d0c703514cd0b108c455"

# Admin Username
ADMIN_USERNAME="admin"

# Generate a bcrypt hash for your admin password
# In python: 
# from passlib.context import CryptContext
# pwd_context = CryptContext(schemes=["bcrypt"], deprecated="auto")
# print(pwd_context.hash("your-secure-password"))
ADMIN_PASSWORD_HASH="$2b$12$oWqcvPJAC.E0Sh6oAoHyfOf5zWRybPMWiyohQUYi8zu5CtfrMrFiO"

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
